# Check the real llcharacter usage requirements without configuring the viewer.
if(NOT DEFINED TEST_WORK_DIR)
  message(FATAL_ERROR "Pass TEST_WORK_DIR inside a test build directory")
endif()
get_filename_component(character_dir "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(STRINGS "${character_dir}/../cmake/Variables.cmake" storage_option
  REGEX "^option\\(FS_CONTIGUOUS_ANIMATION_KEYS ")
if(NOT storage_option MATCHES " OFF\\)$")
  message(FATAL_ERROR "Experimental animation storage must default OFF")
endif()
file(MAKE_DIRECTORY "${TEST_WORK_DIR}/source/modules")
# Other llcharacter dependencies are interface placeholders; no sources build.
file(WRITE "${TEST_WORK_DIR}/source/modules/00-Common.cmake" "")
file(WRITE "${TEST_WORK_DIR}/source/modules/LLCommon.cmake" "")
file(WRITE "${TEST_WORK_DIR}/source/layout.cpp" "int layout_consumer;\n")
set(fixture [=[
cmake_minimum_required(VERSION 3.16)
project(AnimationStorageConfiguration LANGUAGES CXX)
@storage_option@
set(LL_TESTS OFF)
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/modules")
foreach(dependency IN ITEMS llcommon llmath llmessage llfilesystem llxml)
  add_library(${dependency} INTERFACE)
endforeach()
add_subdirectory("@character_dir@" character)
add_library(layout_consumer OBJECT layout.cpp)
target_link_libraries(layout_consumer PRIVATE llcharacter)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/layout-definitions.txt"
  CONTENT "$<TARGET_PROPERTY:layout_consumer,COMPILE_DEFINITIONS>\n")
]=])
string(CONFIGURE "${fixture}" fixture @ONLY)
file(WRITE "${TEST_WORK_DIR}/source/CMakeLists.txt" "${fixture}")
foreach(mode IN ITEMS default OFF ON)
  set(arguments)
  if(NOT mode STREQUAL "default")
    list(APPEND arguments "-DFS_CONTIGUOUS_ANIMATION_KEYS=${mode}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_WORK_DIR}/source"
    -B "${TEST_WORK_DIR}/${mode}" ${arguments}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Configuration fixture failed (${mode}):\n${output}\n${error}")
  endif()
  file(READ "${TEST_WORK_DIR}/${mode}/layout-definitions.txt" definitions)
  if(mode STREQUAL "ON")
    set(expected 1)
  else()
    set(expected 0)
  endif()
  if(NOT definitions MATCHES "(^|;)FS_CONTIGUOUS_ANIMATION_KEYS=${expected}([;\n]|$)")
    message(FATAL_ERROR "Consumer layout definition incorrect (${mode}): ${definitions}")
  endif()
endforeach()
message(STATUS "Default/OFF/ON animation storage definitions propagate to a linked consumer")
