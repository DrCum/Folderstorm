include_guard(GLOBAL)
option(FS_ENABLE_SENTRY "Build opt-in Folderstorm Sentry Native reporting" OFF)
set(FS_SENTRY_DSN "" CACHE STRING "Public Sentry Native project DSN (never an auth token)")
set(FS_HAS_SENTRY 0)
find_package(Git QUIET)
set(FS_SOURCE_COMMIT "" CACHE STRING "Exact source commit for archive builds")
if(NOT FS_SOURCE_COMMIT AND GIT_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
    OUTPUT_VARIABLE FS_SOURCE_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif()
if(NOT FS_SOURCE_COMMIT MATCHES "^[0-9a-f]+$")
  set(FS_SOURCE_COMMIT unknown)
endif()
if(FS_SENTRY_DSN MATCHES "[\"\\;\r\n]" OR (FS_SENTRY_DSN AND NOT FS_SENTRY_DSN MATCHES "^https://[A-Za-z0-9]+@[a-z0-9.-]+/[0-9]+$"))
  message(FATAL_ERROR "FS_SENTRY_DSN must be an HTTPS public project DSN")
endif()
if(FS_ENABLE_SENTRY)
  if(NOT WINDOWS)
    message(FATAL_ERROR "Folderstorm Sentry currently supports Windows only")
  endif()
  if(USE_BUGSPLAT)
    message(FATAL_ERROR "Sentry and BugSplat must not own the crash handler together")
  endif()
  string(LENGTH "${FS_SOURCE_COMMIT}" commit_length)
  if(NOT commit_length EQUAL 40)
    message(FATAL_ERROR "Sentry builds need an exact 40-character FS_SOURCE_COMMIT")
  endif()
  include(FetchContent)
  set(SENTRY_BACKEND crashpad CACHE STRING "" FORCE)
  set(SENTRY_TRANSPORT winhttp CACHE STRING "" FORCE)
  set(SENTRY_BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
  set(SENTRY_BUILD_TESTS OFF CACHE BOOL "" FORCE)
  set(SENTRY_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
  set(SENTRY_BUILD_BENCHMARKS OFF CACHE BOOL "" FORCE)
  FetchContent_Declare(folderstorm_sentry_native
    URL https://github.com/getsentry/sentry-native/releases/download/0.17.3/sentry-native.zip
    URL_HASH SHA256=930039d20b8f7d5520c8cb1d9911d63ce8a9e0635b56ae08256936d1f45b66ac)
  # The viewer inherits /TP and C++-only switches. Do not force SDK C or
  # Crashpad MASM sources through that language or pass C++ flags to ml64.
  get_directory_property(viewer_compile_options COMPILE_OPTIONS)
  get_directory_property(viewer_link_options LINK_OPTIONS)
  # VS cannot represent C/CXX directory options separately in mixed targets;
  # COMPILE_LANGUAGE:CXX around /TP would still force their C files to C++.
  set_property(DIRECTORY PROPERTY COMPILE_OPTIONS "")
  set(viewer_c_flags "${CMAKE_C_FLAGS}")
  set(viewer_cxx_flags "${CMAKE_CXX_FLAGS}")
  # Crashpad declares newer Windows APIs and resolves them dynamically. Keep
  # the viewer's legacy API visibility flags out of the SDK subdirectory only.
  string(REGEX REPLACE "[-/]D(WINVER|_WIN32_WINNT)=[^ ]+" "" sdk_c_flags "${CMAKE_C_FLAGS}")
  string(REGEX REPLACE "[-/]D(WINVER|_WIN32_WINNT)=[^ ]+" "" sdk_cxx_flags "${CMAKE_CXX_FLAGS}")
  set(CMAKE_C_FLAGS "${sdk_c_flags} /Z7")
  set(CMAKE_CXX_FLAGS "${sdk_cxx_flags} /Z7")
  add_link_options(/DEBUG)
  # SDK source and vendored Crashpad are pinned by the archive hash.
  FetchContent_MakeAvailable(folderstorm_sentry_native)
  set(CMAKE_C_FLAGS "${viewer_c_flags}")
  set(CMAKE_CXX_FLAGS "${viewer_cxx_flags}")
  set_property(DIRECTORY PROPERTY COMPILE_OPTIONS "${viewer_compile_options}")
  set_property(DIRECTORY PROPERTY LINK_OPTIONS "${viewer_link_options}")
  set(licenses "${CMAKE_CURRENT_BINARY_DIR}/sentry-licenses")
  file(MAKE_DIRECTORY "${licenses}")
  file(GLOB_RECURSE sentry_notices RELATIVE "${folderstorm_sentry_native_SOURCE_DIR}"
    "${folderstorm_sentry_native_SOURCE_DIR}/*LICENSE*" "${folderstorm_sentry_native_SOURCE_DIR}/*COPYING*" "${folderstorm_sentry_native_SOURCE_DIR}/*NOTICE*")
  foreach(notice IN LISTS sentry_notices)
    if(NOT IS_DIRECTORY "${folderstorm_sentry_native_SOURCE_DIR}/${notice}")
      get_filename_component(notice_dir "${notice}" DIRECTORY)
      file(MAKE_DIRECTORY "${licenses}/${notice_dir}")
      configure_file("${folderstorm_sentry_native_SOURCE_DIR}/${notice}" "${licenses}/${notice}" COPYONLY)
    endif()
  endforeach()
  set(FS_HAS_SENTRY 1)
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/folderstorm-crash-reporting.enabled" "0.17.3\n")
else()
  file(REMOVE "${CMAKE_CURRENT_BINARY_DIR}/folderstorm-crash-reporting.enabled")
endif()
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/fscrashconfig.h.in" "${CMAKE_CURRENT_BINARY_DIR}/fscrashconfig.h" @ONLY)
function(folderstorm_crash_target target)
  target_sources(${target} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/fscrash.cpp")
  if(FS_ENABLE_SENTRY)
    target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:/Z7>")
    target_link_options(${target} PRIVATE /DEBUG)
    # The viewer uses CMake's plain linking signature; the host uses keywords.
    # CMake requires every call for a given target to use the same signature.
    if("${target}" STREQUAL "${VIEWER_BINARY_NAME}")
      target_link_libraries(${target} sentry)
    else()
      target_link_libraries(${target} PRIVATE sentry)
    endif()
    add_dependencies(${target} crashpad_handler)
    add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
      "$<TARGET_FILE:crashpad_handler>" "$<TARGET_FILE_DIR:${target}>/folderstorm-crashpad-handler.exe")
  endif()
endfunction()
set_source_files_properties(fscrash.cpp PROPERTIES SKIP_PRECOMPILE_HEADERS TRUE)
