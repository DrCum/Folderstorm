include_guard()
set(FS_RELEASE_FEED_URL "https://api.github.com/repos/DrCum/Folderstorm/releases?per_page=32" CACHE STRING "Public HTTPS release manifest or Folderstorm GitHub releases API")
set(FS_RELEASE_DOWNLOAD_HOSTS "folderstorm.sodie.net" CACHE STRING "Comma-separated additional trusted HTTPS download hosts")
foreach(value IN ITEMS FS_RELEASE_FEED_URL FS_RELEASE_DOWNLOAD_HOSTS)
  if("${${value}}" MATCHES "[\"\\;\n\r]")
    message(FATAL_ERROR "${value} contains invalid configuration characters")
  endif()
endforeach()
if(NOT FS_RELEASE_FEED_URL MATCHES "^https://[a-z0-9.-]+/")
  message(FATAL_ERROR "FS_RELEASE_FEED_URL must be an HTTPS URL with a lowercase hostname")
endif()
set(FS_RELEASE_PLATFORM "linux")
set(FS_RELEASE_INSTALLER "tar")
if(WINDOWS)
  set(FS_RELEASE_PLATFORM "windows")
  set(FS_RELEASE_INSTALLER "nsis")
elseif(DARWIN)
  set(FS_RELEASE_PLATFORM "macos")
  set(FS_RELEASE_INSTALLER "dmg")
endif()
if(USE_VELOPACK)
  set(FS_RELEASE_INSTALLER "velopack")
endif()
set(FS_RELEASE_ARCH "x86_64")
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$" OR CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
  set(FS_RELEASE_ARCH "arm64")
endif()
set(FS_RELEASE_CPU "baseline")
if(USE_AVX2_OPTIMIZATION)
  set(FS_RELEASE_CPU "avx2")
elseif(USE_AVX_OPTIMIZATION)
  set(FS_RELEASE_CPU "avx")
endif()
set(FS_RELEASE_FLAVOR "secondlife")
if(OPENSIM)
  set(FS_RELEASE_FLAVOR "opensim")
endif()
set(FS_RELEASE_DEFAULT_CHANNEL "stable")
if(NOT VIEWER_CHANNEL MATCHES "Release")
  set(FS_RELEASE_DEFAULT_CHANNEL "nightly")
endif()
configure_file(fsreleasebuild.h.in ${CMAKE_CURRENT_BINARY_DIR}/fsreleasebuild.h @ONLY)
