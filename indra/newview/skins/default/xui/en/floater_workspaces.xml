 <text name="active" left="12" top="28" right="-12" height="20" follows="left|right|top" use_ellipses="true"
  tool_tip="An asterisk means supported workspace components have changed." />
 <tab_container name="workspace_pages" left="8" top="52" right="-8" bottom="-44" follows="all" tab_position="top">
  <panel name="switch_page" label="Switch" width="430" height="368" layout="topleft">
   <filter_editor name="profile_filter" label="Find a workspace or layout" left="8" top="9" right="-8" height="24" follows="left|right|top" />
   <scroll_list name="profiles" left="8" top="40" right="-8" bottom="-102" follows="all"
    draw_heading="false" multi_select="false" can_sort="false" column_padding="8" search_column="0">
    <scroll_list.columns name="name" dynamic_width="true" />
    <scroll_list.columns name="kind" width="85" />
   </scroll_list>
   <button name="favorite" label="Favorite" left="8" bottom="-72" width="114" height="23" follows="left|bottom" />
   <button name="favorite_up" label="↑" left="126" bottom="-72" width="26" height="23" follows="left|bottom"
    tool_tip="Move this favorite earlier. Clear the search to reorder favorites." />
   <button name="favorite_down" label="↓" left="155" bottom="-72" width="26" height="23" follows="left|bottom"
    tool_tip="Move this favorite later. Clear the search to reorder favorites." />
   <button name="shortcut" label="Assign shortcut" right="-8" bottom="-72" width="132" height="23" follows="right|bottom"
    tool_tip="Use this entry for the workspace shortcut assigned in Preferences > Controls." />
   <combo_box name="apply_group" left="8" bottom="-42" right="-123" height="23" follows="left|right|bottom"
    tool_tip="Choose one part of the selected workspace to apply." />
   <button name="apply_selected_group" label="Apply group" right="-8" bottom="-42" width="108" height="23" follows="right|bottom" />
   <button name="previous" label="Previous" left="8" bottom="-10" width="88" height="24" follows="left|bottom"
    tool_tip="Return to the arrangement before switching, including unsaved positions." />
   <button name="diagram_preview" label="Preview…" left="102" bottom="-10" width="88" height="24" follows="left|bottom"
    tool_tip="Preview the selected workspace without switching." />
   <button name="switch" label="Switch" right="-8" bottom="-10" width="104" height="24" follows="right|bottom" />
  </panel>
  <panel name="save_page" label="Save" width="430" height="368" layout="topleft">
   <text name="save_name_label" left="8" top="10" right="-8" height="18" follows="left|right|top">New workspace name</text>
   <line_editor name="workspace_name" label="Workspace name" left="8" top="32" right="-113" height="24"
    follows="left|right|top" max_length="64" />
   <button name="save" label="Save new" right="-8" top="32" width="98" height="24" follows="right|top" />
   <scroll_container name="capture_scroll" left="4" top="65" right="-4" bottom="-42" follows="all" opaque="false"
    reserve_scroll_corner="false">
    <panel name="save_controls" left="0" top="0" width="395" height="526" layout="topleft" follows="left|right|top">
  <check_box name="capture_chrome" label="Restore viewport and bar placement" initial_value="true" left="6" top="4" right="-6" height="18" follows="left|right|top"/>
  <check_box name="capture_inventory" label="Restore Inventory windows and Received Items" initial_value="true" left="6" top="28" right="-6" height="18" follows="left|right|top"/>
  <check_box name="capture_maps" label="Restore maps" initial_value="true" left="6" top="52" right="-6" height="18" follows="left|right|top"/>
  <check_box name="capture_chat" label="Restore compatible chat geometry" initial_value="true" left="6" top="76" right="-6" height="18" follows="left|right|top"/>
  <check_box name="remember_inventory_folders" label="Remember Inventory folders" left="6" top="100" right="-6" height="18" follows="left|right|top"
   tool_tip="For this save: restore single-folder roots and view modes, or a selected folder and expanded branches in All Items (up to 256). Search filters and item selections are not saved."/>
  <check_box name="capture_toolbars" label="Restore toolbar buttons and display mode" left="6" top="124" right="-6" height="18" follows="left|right|top"/>
  <check_box name="capture_background" label="Restore workspace background" initial_value="true" left="6" top="148" right="-6" height="18" follows="left|right|top"/>
  <panel name="workspace_context" filename="panel_workspace_context.xml" left="6" top="180" right="-6" height="334" follows="left|right|top"/>
    </panel>
   </scroll_container>
   <button name="update" label="Update current workspace…" left="8" bottom="-10" right="-8" height="24" follows="left|right|bottom"
    tool_tip="Review changes to the current saved workspace." />
  </panel>
  <panel name="tools_page" label="Tools" width="430" height="368" layout="topleft">
   <button name="tools" label="Arrange windows…" left="8" top="10" right="-8" height="24" follows="left|right|top" />
   <button name="recover_windows" label="Recover windows now" left="8" top="41" right="-8" height="24" follows="left|right|top" />
   <check_box name="display_recovery" label="Recover arrangement when displays change" control_name="FSWorkspaceDisplayRecovery"
    left="8" top="77" right="-8" height="20" follows="left|right|top" />
   <check_box name="show_favorites_strip" label="Show workspace favorites strip" control_name="FSShowWorkspaceFavoritesStrip"
    left="8" top="103" right="-8" height="20" follows="left|right|top" />
   <check_box name="quiet_ui" label="Quiet UI for this session" left="8" top="129" right="-8" height="20" follows="left|right|top"
    tool_tip="Temporarily hide navigation, favorites, toolbars and routine popups. Turn off here or in World to restore them." />
   <button name="restore_report" label="Last restore report…" left="8" top="166" right="-8" height="24" follows="left|right|top" />
   <button name="manage" label="Preferences…" left="8" top="197" right="-8" height="24" follows="left|right|top" />
  </panel>
 </tab_container>
 <text name="status" left="12" bottom="-6" right="-12" height="32" follows="left|right|bottom" wrap="true" />
</floater>
