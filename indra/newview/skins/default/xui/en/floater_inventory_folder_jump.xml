<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="inventory_folder_jump" title="Go to inventory folder"
         width="540" height="382" min_width="350" min_height="250"
         can_resize="true" can_minimize="false" save_rect="true" layout="topleft">
    <string name="looking">Finding folders…</string>
    <string name="no_results">No folders match. Try part of a folder or parent name.</string>
    <string name="limited">Showing [LIMIT] of [COUNT]. Type more to narrow the list.</string>
    <string name="matches">Matching folders: [COUNT]</string>
    <string name="at_root">Top-level folders</string>
    <string name="inventory_root">My Inventory</string>
    <filter_editor name="query" label="Folder or parent name"
                   left="12" top="30" right="-12" height="25" follows="left|right|top"
                   tool_tip="Search folder names and paths. For example, Clothes / Boots." />
    <scroll_list name="folders" left="12" top="63" right="-12" bottom="-77" follows="all"
                 draw_heading="true" can_sort="false" multi_select="false">
        <scroll_list.columns name="name" label="Folder" relative_width="0.45" />
        <scroll_list.columns name="parent" label="In folder" relative_width="0.55" />
    </scroll_list>
    <text name="status" left="12" right="-12" bottom="-41" height="32" follows="left|right|bottom" wrap="true" />
    <button name="cancel" label="Cancel" right="-119" bottom="-10" width="85" height="23" follows="right|bottom" />
    <button name="open_folder" label="Open folder" right="-12" bottom="-10" width="100" height="23" follows="right|bottom"
            tool_tip="Open this folder in a folder window. Your current inventory search is kept." />
</floater>
