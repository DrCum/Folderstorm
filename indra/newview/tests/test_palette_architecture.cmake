include("${CMAKE_CURRENT_LIST_DIR}/folderstorm/PaletteArchitecture.cmake")

function(check system osx generator vs expected)
  set(CMAKE_SYSTEM_PROCESSOR "${system}")
  set(CMAKE_OSX_ARCHITECTURES "${osx}")
  set(CMAKE_GENERATOR_PLATFORM "${generator}")
  set(CMAKE_VS_PLATFORM_NAME "${vs}")
  folderstorm_palette_needs_sse2neon(actual)
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "Wrong palette architecture: host=${system}, osx=${osx}, generator=${generator}, vs=${vs}: ${actual}, expected ${expected}")
  endif()
endfunction()

check("AMD64" "" "" "" FALSE)
check("aarch64" "" "" "" TRUE)
check("arm64" "" "" "" TRUE)
check("x86_64" "x86_64" "" "" FALSE)
check("x86_64" "arm64" "" "" TRUE)
check("x86_64" "arm64;x86_64" "" "" TRUE)
check("x86_64" "x86_64;arm64" "" "" TRUE)
check("arm64" "x86_64" "" "" FALSE)
check("x86_64" "arm64e;x86_64" "" "" TRUE)
check("AMD64" "" "ARM64" "" TRUE)
check("AMD64" "" "ARM64,version=10.0.26100.0" "" TRUE)
check("ARM64" "" "x64" "ARM64" FALSE)
check("AMD64" "" "" "ARM64" TRUE)
message(STATUS "13 palette architecture configurations passed")
