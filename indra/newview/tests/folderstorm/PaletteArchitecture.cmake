# Prefer explicit target architectures over the configure host. In particular,
# macOS universal builds compile each CMAKE_OSX_ARCHITECTURES slice.
function(folderstorm_palette_needs_sse2neon result)
  if(CMAKE_OSX_ARCHITECTURES)
    set(architectures "${CMAKE_OSX_ARCHITECTURES}")
  elseif(CMAKE_GENERATOR_PLATFORM)
    set(architectures "${CMAKE_GENERATOR_PLATFORM}")
  elseif(CMAKE_VS_PLATFORM_NAME)
    set(architectures "${CMAKE_VS_PLATFORM_NAME}")
  else()
    set(architectures "${CMAKE_SYSTEM_PROCESSOR}")
  endif()
  foreach(architecture IN LISTS architectures)
    string(TOLOWER "${architecture}" architecture)
    if(architecture MATCHES "^(aarch64|arm64|arm64e)(,.*)?$")
      set(${result} TRUE PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${result} FALSE PARENT_SCOPE)
endfunction()
