<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup><Reference Include="Folderstorm.Theme.Core"><HintPath>$(LegacyThemeCore)</HintPath></Reference></ItemGroup>
  <Target Name="RequireLegacyCore" BeforeTargets="ResolveReferences"><Error Condition="!Exists('$(LegacyThemeCore)')" Text="Pass -p:LegacyThemeCore=&lt;previous retained Core DLL&gt;"/></Target>
</Project>
