<UserControl x:Class="Folderstorm.Theme.Editor.FontWorkbench" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#F5F3FA">
  <Grid Margin="14" TextElement.Foreground="#F5F3FA">
    <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <DockPanel>
      <StackPanel DockPanel.Dock="Top">
        <ComboBox x:Name="Configuration" AutomationProperties.Name="Bundled font configuration"/>
        <Button Content="Use configuration" Click="UseConfiguration" IsEnabled="{Binding CanEditDocument}" Margin="0,8,0,16"/>
        <TextBox x:Name="Search" TextChanged="SearchRoles" AutomationProperties.Name="Search font roles" ToolTip="Search font role or style" Margin="0,0,0,10"/>
      </StackPanel>
      <Button DockPanel.Dock="Bottom" Content="Reset fonts" Click="ResetFonts" IsEnabled="{Binding CanEditDocument}" Margin="0,12,0,0" ToolTip="Restore inherited font settings. Undo restores your changes and embedded fonts."/>
      <ListBox x:Name="Roles" DisplayMemberPath="Label" SelectionChanged="SelectRole" AutomationProperties.Name="Font roles" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </DockPanel>
    <ScrollViewer Grid.Column="2" x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
      <StackPanel>
        <DockPanel><TextBlock x:Name="RoleName" FontSize="22"/><TextBlock DockPanel.Dock="Right" Text="WPF approximation" Foreground="#ADA9BA" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
        <StackPanel x:Name="FacePanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="Inspect collection face" Foreground="#ADA9BA"/><ComboBox x:Name="FaceChoice" DisplayMemberPath="Label" SelectionChanged="SelectFace" AutomationProperties.Name="Inspected collection face" Margin="0,5,0,0" ToolTip="Inspection only. Native collection loading still uses all faces in file order."/></StackPanel>
        <Border Background="#111016" BorderBrush="#51445F" BorderThickness="1" Padding="18" Margin="0,12,0,12">
          <StackPanel><TextBlock x:Name="Specimen" Text="The quick violet fox" FontSize="30" TextWrapping="Wrap"/><TextBlock x:Name="SpecimenSmall" Text="Русский · 中文 · Aa 0123 · 🙂" FontSize="16" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
        </Border>
        <TextBlock x:Name="FaceCoverage" Foreground="#ADA9BA" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBox x:Name="SampleText" Text="The quick violet fox · Русский · 中文 · 🙂" MaxLength="2048" TextChanged="SampleChanged" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="38" MaxHeight="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Font sample text"/>
        <TextBlock Text="Windows fallback order" Foreground="#ADA9BA" Margin="0,16,0,6"/>
        <ListBox x:Name="References" Height="148" DisplayMemberPath="Label" SelectionChanged="SelectReference" AutomationProperties.Name="Font fallback files" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        <WrapPanel Margin="0,8,0,12" IsEnabled="{Binding CanEditDocument}"><Button Content="Up" Click="MoveUp"/><Button Content="Down" Click="MoveDown"/><Button Content="Remove file" Click="RemoveFile"/></WrapPanel>
        <StackPanel IsEnabled="{Binding CanEditDocument}">
          <TextBlock Text="Font file" Foreground="#ADA9BA"/>
          <ComboBox x:Name="Available" DisplayMemberPath="Label" AutomationProperties.Name="Available font file" Margin="0,5,0,10"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0"><TextBlock Text="Size adjustment" Foreground="#ADA9BA"/><TextBox x:Name="SizeDelta" Text="0" AutomationProperties.Name="Font size adjustment" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Weight, optional" Foreground="#ADA9BA"/><TextBox x:Name="Weight" AutomationProperties.Name="Font weight" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Hinting" Foreground="#ADA9BA"/><ComboBox x:Name="Hinting" SelectedIndex="0" AutomationProperties.Name="Font hinting" Margin="0,5,0,0"><ComboBoxItem Content="force_auto"/><ComboBoxItem Content="default"/><ComboBoxItem Content="no_hinting"/></ComboBox></StackPanel>
          </Grid>
          <WrapPanel Margin="0,12,0,12"><CheckBox x:Name="Collection" Content="Load all collection faces" Foreground="#F5F3FA" Margin="0,0,18,0"/><CheckBox x:Name="SyntheticBold" Content="Bold flag" Foreground="#F5F3FA"/></WrapPanel>
          <WrapPanel><Button Content="Set file" Click="SetFile"/><Button Content="Add fallback" Click="AddFallback"/><Button Content="Embed font…" Click="EmbedFont"/></WrapPanel>
          <TextBlock Text="License text for next embedded font, optional" Foreground="#ADA9BA" Margin="0,16,0,5"/>
          <TextBox x:Name="LicenseText" Height="66" MaxLength="65536" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Embedded font license text"/>
          <TextBlock Text="Native size" Foreground="#ADA9BA" Margin="0,16,0,6"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="Set size" Click="SetNativeSize" Margin="10,0,0,0"/><TextBox DockPanel.Dock="Right" x:Name="NativeSize" Width="76" Text="12" AutomationProperties.Name="Native font point size" Margin="10,0,0,0"/><ComboBox x:Name="SizeName" SelectionChanged="SelectSize" AutomationProperties.Name="Native font size name"/></DockPanel>
        </StackPanel>
        <TextBlock x:Name="Status" Foreground="#64D8B2" TextWrapping="Wrap" Margin="0,14,0,0"/>
        <TextBlock x:Name="Coverage" TextWrapping="Wrap" Margin="0,14,0,0"/>
        <Expander Header="Font details and license" Foreground="#F5F3FA" IsExpanded="True" Margin="0,16,0,0"><TextBlock x:Name="Details" TextWrapping="Wrap" Foreground="#ADA9BA" Margin="0,8,0,0"/></Expander>
        <Expander x:Name="EmbeddedLicensePanel" Header="Packaged license for selected font" Foreground="#F5F3FA" Visibility="Collapsed" IsExpanded="True" Margin="0,16,0,0"><StackPanel IsEnabled="{Binding CanEditDocument}" Margin="0,8,0,0"><TextBlock x:Name="LicensePath" TextWrapping="Wrap" Foreground="#ADA9BA"/><TextBox x:Name="PackagedLicense" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="65536" Height="144" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8" AutomationProperties.Name="Selected font packaged license"/><WrapPanel><Button Content="Save license" Click="SaveLicense"/><Button x:Name="RemoveLicenseButton" Content="Remove license" Click="RemoveLicense"/></WrapPanel></StackPanel></Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
