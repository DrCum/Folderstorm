<Window x:Class="Folderstorm.Theme.Editor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Folderstorm.Theme.Editor" Title="Folderstorm theme lab · Authoring" Width="1360" Height="900" MinWidth="1080" MinHeight="700" Background="#111016" Foreground="#F5F3FA" Closing="OnClosing">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="Theme lab" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="ProjectLabel" Text="Classic AnsaStorm" Foreground="#ADA9BA" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="420"/></StackPanel>
      <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="New / open" Click="OpenProject" IsEnabled="{Binding CanOpenDocument}"/><Button Content="Save" Click="SaveProject" IsEnabled="{Binding CanEditDocument}"/><Button Content="Save as" Click="SaveAsProject" IsEnabled="{Binding CanEditDocument}"/><Button Content="Undo" Click="Undo" IsEnabled="{Binding CanUndo}"/><Button Content="Redo" Click="Redo" IsEnabled="{Binding CanRedo}"/><Button Content="Export" Click="Export" IsEnabled="{Binding CanEditDocument}"/></WrapPanel>
    </DockPanel>
    <Expander x:Name="SetupExpander" Grid.Row="1" Header="Setup" Margin="0,0,0,12" Foreground="#ADA9BA" IsExpanded="True">
      <Grid Margin="0,10,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Base viewer folder" Margin="0,0,0,5"/><TextBox x:Name="BasePath" AutomationProperties.Name="Base viewer or repository folder" ToolTip="Matching viewer's skins and fonts, or source checkout"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="New project scheme" Margin="0,0,0,5"/><ComboBox x:Name="BaseScheme" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Base scheme"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Preview viewer" Margin="0,0,0,5"/><TextBox x:Name="ViewerPath" AutomationProperties.Name="Matching viewer executable" ToolTip="Viewer executable with offline theme preview support"/></StackPanel>
      </Grid>
    </Expander>
    <Border x:Name="ReadOnlyBanner" Grid.Row="2" Background="#3A2D20" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock x:Name="ReadOnlyMessage" Foreground="#F2CD94" TextWrapping="Wrap"/></Border>
    <TabControl Grid.Row="3" x:Name="Workspace">
      <TabItem Header="Palette"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="255" MinWidth="190"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="300" MinWidth="270"/></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,6,0">
          <StackPanel DockPanel.Dock="Top"><ComboBox x:Name="ColorScope" SelectedIndex="0" SelectionChanged="FilterColors" AutomationProperties.Name="Color scope"><ComboBoxItem Content="Roles"/><ComboBoxItem Content="All colors"/><ComboBoxItem Content="Overrides"/><ComboBoxItem Content="Affected colors"/></ComboBox><TextBox x:Name="ColorSearch" TextChanged="SearchColors" AutomationProperties.Name="Search colors" ToolTip="Search color IDs" Margin="0,9,0,10"/></StackPanel>
          <StackPanel DockPanel.Dock="Bottom" IsEnabled="{Binding CanEditDocument}" Margin="0,10,0,0"><Button Content="Palette tools…" Click="OpenPaletteTools" ToolTip="Presets and one-step bulk color, link or reset. Ctrl/Shift selects colors." Margin="0,0,0,8"/><Button Content="Reset palette" Click="ResetPalette" Margin="0"/></StackPanel>
          <ListBox x:Name="ColorList" SelectionMode="Extended" SelectionChanged="SelectColor" AutomationProperties.Name="Color catalog"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Rectangle Width="15" Height="15" Fill="{Binding Swatch}" Stroke="#766B89" VerticalAlignment="Top" Margin="0,2,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding State}" Foreground="#ADA9BA" FontSize="11" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
        </DockPanel>
        <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Center" Background="#302D3B"/>
        <Grid Grid.Column="2" Margin="8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <DockPanel Margin="8,2,8,14"><TextBlock Text="Quick preview" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="WPF approximation" Foreground="#ADA9BA" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
          <TextBlock Grid.Row="1" Text="Before" Foreground="#ADA9BA" Margin="8,0,0,3"/>
          <local:PaletteSample Grid.Row="2" x:Name="BeforeSample" MinHeight="165"/>
          <TextBlock Grid.Row="3" Text="After" Foreground="#BFA4FC" Margin="8,12,0,3"/>
          <local:PaletteSample Grid.Row="4" x:Name="AfterSample" MinHeight="165"/>
        </Grid>
        <GridSplitter Grid.Column="3" Width="2" HorizontalAlignment="Center" Background="#302D3B"/>
        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel Margin="10,0,14,0">
          <TextBlock x:Name="ColorName" Text="Choose a color" FontSize="20" TextWrapping="Wrap"/><TextBlock x:Name="ColorState" Foreground="#BFA4FC" Margin="0,5,0,0"/>
          <Border Height="70" Margin="0,16,0,14" Background="{StaticResource Checkerboard}"><Border x:Name="ColorSwatch"/></Border>
          <StackPanel IsEnabled="{Binding CanEditDocument}"><TextBlock Text="Hex / RGBA" Foreground="#ADA9BA" Margin="0,0,0,5"/><DockPanel><Button DockPanel.Dock="Right" Content="Pick" Click="PickFieldColor" Tag="{Binding ElementName=ColorValue}" ToolTip="Choose color and opacity" Margin="8,0,0,0"/><TextBox x:Name="ColorValue" Text="#FFFFFFFF" FontFamily="Consolas" AutomationProperties.Name="Hex or RGBA value"/></DockPanel><TextBlock x:Name="ColorDraftState" Text="Not applied" Foreground="#F2CD94" Visibility="Collapsed" Margin="0,6,0,0" ToolTip="Use Set color to apply this value before saving or copying the project."/><TextBlock x:Name="ColorFormats" Foreground="#ADA9BA" FontFamily="Consolas" FontSize="11" Margin="0,6,0,8" TextWrapping="Wrap"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="R"/><Slider Grid.Column="1" x:Name="RedChannel" Minimum="0" Maximum="255" TickFrequency="1" ValueChanged="ChannelChanged" AutomationProperties.Name="Red channel"/><TextBlock Grid.Column="2" Text="{Binding ElementName=RedChannel,Path=Value,StringFormat={}{0:F0}}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="1" Text="G"/><Slider Grid.Row="1" Grid.Column="1" x:Name="GreenChannel" Minimum="0" Maximum="255" ValueChanged="ChannelChanged" AutomationProperties.Name="Green channel"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=GreenChannel,Path=Value,StringFormat={}{0:F0}}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="2" Text="B"/><Slider Grid.Row="2" Grid.Column="1" x:Name="BlueChannel" Minimum="0" Maximum="255" ValueChanged="ChannelChanged" AutomationProperties.Name="Blue channel"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ElementName=BlueChannel,Path=Value,StringFormat={}{0:F0}}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="3" Text="A"/><Slider Grid.Row="3" Grid.Column="1" x:Name="AlphaChannel" Minimum="0" Maximum="255" ValueChanged="ChannelChanged" AutomationProperties.Name="Alpha channel"/><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ElementName=AlphaChannel,Path=Value,StringFormat={}{0:F0}}" HorizontalAlignment="Right"/>
            </Grid>
            <WrapPanel Margin="0,14,0,16"><Button Content="Set color" Click="SetColor"/><Button Content="Reset" Click="ResetColor"/></WrapPanel>
            <TextBlock Text="Link to color" Foreground="#ADA9BA" Margin="0,0,0,5"/><ComboBox x:Name="ColorLinkTarget" IsEditable="True" IsTextSearchEnabled="True" AutomationProperties.Name="Linked color ID"/><Button Content="Set link" Click="SetColorLink" HorizontalAlignment="Left" Margin="0,9,0,0"/>
          </StackPanel>
          <TextBlock x:Name="ColorContrast" Margin="0,18,0,0" Foreground="#64D8B2"/><TextBlock x:Name="ColorSource" Foreground="#ADA9BA" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock x:Name="ColorAffected" Foreground="#ADA9BA" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel></ScrollViewer>
      </Grid></TabItem>
      <TabItem Header="Images"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="230" MinWidth="180"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="300" MinWidth="270"/></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,6,0"><StackPanel DockPanel.Dock="Top"><TextBox x:Name="TextureSearch" TextChanged="SearchTextures" AutomationProperties.Name="Search images" ToolTip="Search image IDs or filenames. Try .tga" Margin="0,0,0,9"/><ComboBox x:Name="ImageFamily" SelectionChanged="FilterImageFamily" DisplayMemberPath="Label" SelectedValuePath="Name" AutomationProperties.Name="Image family" Margin="0,0,0,8"/><CheckBox x:Name="ImageOverridesOnly" Content="Overrides" Foreground="#F5F3FA" Checked="FilterImageOverrides" Unchecked="FilterImageOverrides" Margin="0,0,0,10"/></StackPanel><ListBox x:Name="TextureList" DisplayMemberPath="Name" SelectionChanged="SelectTexture" AutomationProperties.Name="Image catalog"/></DockPanel>
        <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Center" Background="#302D3B"/>
        <Grid Grid.Column="2" Margin="8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><ComboBox x:Name="ImageComparison" Width="105" SelectedIndex="0" SelectionChanged="CompareImage" AutomationProperties.Name="Image comparison"><ComboBoxItem Content="Current"/><ComboBoxItem Content="Original"/></ComboBox><ComboBox x:Name="ImageZoom" Width="72" SelectedIndex="0" SelectionChanged="ZoomImage" AutomationProperties.Name="Image zoom" Margin="8,0,0,0"><ComboBoxItem Content="Fit"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/><ComboBoxItem Content="8×"/><ComboBoxItem Content="16×"/></ComboBox></StackPanel><CheckBox x:Name="ShowImageGuides" Content="Guides" IsChecked="True" Foreground="#F5F3FA" Checked="ToggleImageGuides" Unchecked="ToggleImageGuides" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
          <WrapPanel Grid.Row="1" IsEnabled="{Binding CanEditImage}" Margin="0,0,0,10">
            <ComboBox x:Name="ImageTool" Width="100" SelectedIndex="0" SelectionChanged="DrawingSettingsChanged" AutomationProperties.Name="Pixel drawing tool" Margin="0,0,8,0" ToolTip="Inspect picks pixels and moves guides. Pen, line and circle draw exact pixels. Escape cancels a gesture."><ComboBoxItem Content="Inspect"/><ComboBoxItem Content="Pen"/><ComboBoxItem Content="Line"/><ComboBoxItem Content="Circle" ToolTip="Drag from the center to the edge"/></ComboBox>
            <TextBox x:Name="DrawingColor" Text="#FFFFFFFF" Width="105" TextChanged="DrawingSettingsChanged" FontFamily="Consolas" AutomationProperties.Name="Drawing color"/><Button Content="Pick" Click="PickFieldColor" Tag="{Binding ElementName=DrawingColor}" ToolTip="Choose drawing color and opacity"/>
            <ComboBox x:Name="DrawingSize" Width="82" SelectedIndex="0" SelectionChanged="DrawingSettingsChanged" AutomationProperties.Name="Pixel brush size" Margin="0,0,8,0"><ComboBoxItem Content="1 px"/><ComboBoxItem Content="2 px"/><ComboBoxItem Content="4 px"/><ComboBoxItem Content="8 px"/></ComboBox>
            <CheckBox x:Name="PixelGrid" Content="Grid" IsChecked="True" Checked="DrawingSettingsChanged" Unchecked="DrawingSettingsChanged" Foreground="#F5F3FA" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Show pixel grid at 6× zoom or larger"/>
            <Button Content="Clear" Click="ClearDrawing" ToolTip="Clear this image to transparent. Undo restores the artwork."/>
          </WrapPanel>
          <Border Grid.Row="2" BorderBrush="#302D3B" BorderThickness="1" Background="{StaticResource Checkerboard}"><ScrollViewer x:Name="ImageViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" SizeChanged="ImageViewportChanged"><local:ImageCanvas x:Name="EditCanvas" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Image canvas"/></ScrollViewer></Border>
          <DockPanel Grid.Row="3" Margin="0,10,0,5"><TextBlock Text="Samples" Foreground="#ADA9BA" VerticalAlignment="Center"/><ComboBox x:Name="ImageSampleMode" SelectedIndex="0" SelectionChanged="ImageSampleModeChanged" Width="115" HorizontalAlignment="Right" AutomationProperties.Name="Image sample mode"><ComboBoxItem Content="Stretch"/><ComboBoxItem Content="Tile"/></ComboBox></DockPanel>
          <UniformGrid Grid.Row="4" Columns="3"><Border Background="{StaticResource Checkerboard}" BorderBrush="#302D3B" BorderThickness="1" Padding="5" Margin="0,0,5,0"><StackPanel><TextBlock x:Name="StretchSize1" FontSize="10" Foreground="#ADA9BA"/><Image x:Name="StretchImage1" Height="65" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></StackPanel></Border><Border Background="{StaticResource Checkerboard}" BorderBrush="#302D3B" BorderThickness="1" Padding="5" Margin="0,0,5,0"><StackPanel><TextBlock x:Name="StretchSize2" FontSize="10" Foreground="#ADA9BA"/><Image x:Name="StretchImage2" Height="65" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></StackPanel></Border><Border Background="{StaticResource Checkerboard}" BorderBrush="#302D3B" BorderThickness="1" Padding="5"><StackPanel><TextBlock x:Name="StretchSize3" FontSize="10" Foreground="#ADA9BA"/><Image x:Name="StretchImage3" Height="65" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></StackPanel></Border></UniformGrid>
          <TextBlock Grid.Row="5" x:Name="ImagePixel" Text="Point to inspect a pixel; click to pick its color." Foreground="#ADA9BA" FontFamily="Consolas" FontSize="11" Margin="0,10,0,0"/>
        </Grid>
        <GridSplitter Grid.Column="3" Width="2" HorizontalAlignment="Center" Background="#302D3B"/>
        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="10,0,14,0"><TextBlock x:Name="TextureName" Text="Choose an image" FontSize="20" TextWrapping="Wrap"/><TextBlock x:Name="ImageState" TextWrapping="Wrap" Foreground="#BFA4FC" Margin="0,5,0,0"/><TextBlock x:Name="ImageDimensions" Foreground="#ADA9BA" Margin="0,5,0,0"/><Button Content="Import image…" Click="ReplaceImage" IsEnabled="{Binding CanReplaceImage}" Margin="0,14,0,12" ToolTip="PNG, TGA, BMP or JPEG. Keeps original bytes and prepares a PNG for this logical image ID."/>
          <Button Content="Reset guides" Click="RepairImageGuides" Margin="0,0,0,12" ToolTip="Replace invalid guides with full-image clipping and zero margins. Undo restores inherited guides."><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanRepairImageGuides}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          <WrapPanel IsEnabled="{Binding CanReplaceImage}" Margin="0,0,0,14"><Button Content="Reset image" Click="ResetSelectedImage" ToolTip="Restore inherited artwork and guides for this image. Undo restores your edit."/><Button Content="Reset family" Click="ResetSelectedFamily" ToolTip="Restore every state in this image's family as one undoable change."/></WrapPanel>
          <Button Content="Edit family…" Click="EditStateFamily" IsEnabled="{Binding CanReplaceImage}" HorizontalAlignment="Left" Margin="0,0,0,14" ToolTip="Preview and choose state images to tint, adjust, resize or share guides. Apply makes one Undo step."/>
          <Expander Header="External editor" Foreground="#F5F3FA" Margin="0,0,0,14"><StackPanel Margin="0,10,0,0">
            <DockPanel><Button DockPanel.Dock="Right" Content="Choose" Click="ChooseExternalEditor" IsEnabled="{Binding CanOpenDocument}"/><TextBlock x:Name="ExternalAppName" Text="Choose an image editor" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
            <WrapPanel Margin="0,8,0,6"><Button Content="Open copy" Click="OpenExternalCopy" IsEnabled="{Binding CanEditImage}" ToolTip="Open a separate PNG working copy. Originals are kept."/><Button Content="Reload" Click="ReloadExternalCopy" IsEnabled="{Binding CanReloadExternal}" ToolTip="Apply the changed working PNG as one undoable edit."/></WrapPanel>
            <TextBlock x:Name="ExternalChangeStatus" Text="Save in your editor, then Reload." TextWrapping="Wrap" Foreground="#64D8B2"/>
            <TextBox x:Name="ExternalPath" IsReadOnly="True" FontSize="11" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.Name="External working PNG path"/>
            <Button Content="Working files" Click="BrowseWorkingFiles" IsEnabled="{Binding CanBrowseWorkingFiles}" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Working copies are kept here after the lab closes."/>
          </StackPanel></Expander>
          <StackPanel IsEnabled="{Binding CanEditImage}">
            <TextBlock Text="Tint" Foreground="#ADA9BA" Margin="0,0,0,5"/><DockPanel><Button DockPanel.Dock="Right" Content="Pick" Click="PickFieldColor" Tag="{Binding ElementName=ImageTint}" ToolTip="Choose color and opacity" Margin="8,0,0,0"/><TextBox x:Name="ImageTint" Text="#FFFFFFFF" FontFamily="Consolas" AutomationProperties.Name="Image tint"/></DockPanel><Button Content="Apply tint" Click="TintImage" HorizontalAlignment="Left" Margin="0,8,0,16"/>
            <Expander Header="Size and crop" IsExpanded="True" Foreground="#F5F3FA"><StackPanel Margin="0,10,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Width" Foreground="#ADA9BA"/><TextBox x:Name="ImageWidth" Text="32" TextChanged="ImageWidthChanged" AutomationProperties.Name="Image width" Margin="0,5,8,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Height" Foreground="#ADA9BA"/><TextBox x:Name="ImageHeight" Text="24" TextChanged="ImageHeightChanged" AutomationProperties.Name="Image height" Margin="0,5,0,0"/></StackPanel></Grid><CheckBox x:Name="KeepImageRatio" Content="Keep ratio" IsChecked="True" Foreground="#F5F3FA" Margin="0,9,0,9"/><ComboBox x:Name="ImageInterpolation" SelectedIndex="1" AutomationProperties.Name="Resize interpolation"><ComboBoxItem Content="Nearest pixel"/><ComboBoxItem Content="Bilinear"/></ComboBox><Button Content="Resize" Click="ResizeImage" HorizontalAlignment="Left" Margin="0,9,0,14"/>
              <UniformGrid Columns="4"><StackPanel><TextBlock Text="X"/><TextBox x:Name="CropX" Text="0" AutomationProperties.Name="Crop X" Margin="0,5,5,0"/></StackPanel><StackPanel><TextBlock Text="Y"/><TextBox x:Name="CropY" Text="0" AutomationProperties.Name="Crop Y" Margin="0,5,5,0"/></StackPanel><StackPanel><TextBlock Text="W"/><TextBox x:Name="CropWidth" Text="32" AutomationProperties.Name="Crop width" Margin="0,5,5,0"/></StackPanel><StackPanel><TextBlock Text="H"/><TextBox x:Name="CropHeight" Text="24" AutomationProperties.Name="Crop height" Margin="0,5,0,0"/></StackPanel></UniformGrid><Button Content="Crop" Click="CropImage" HorizontalAlignment="Left" Margin="0,9,0,0"/></StackPanel></Expander>
            <Expander Header="Adjust" Foreground="#F5F3FA" Margin="0,0,0,14"><StackPanel Margin="0,10,0,0"><TextBlock Text="Brightness"/><Slider AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2" SmallChange="0.01" LargeChange="0.1" x:Name="ImageBrightness" Minimum="-1" Maximum="1" Value="0" AutomationProperties.Name="Brightness"/><TextBlock Text="Contrast"/><Slider AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2" SmallChange="0.01" LargeChange="0.1" x:Name="ImageContrast" Minimum="-1" Maximum="1" Value="0" AutomationProperties.Name="Contrast"/><TextBlock Text="Saturation"/><Slider AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2" SmallChange="0.05" LargeChange="0.1" x:Name="ImageSaturation" Minimum="0" Maximum="2" Value="1" AutomationProperties.Name="Saturation"/><TextBlock Text="Gamma"/><Slider AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2" SmallChange="0.05" LargeChange="0.1" x:Name="ImageGamma" Minimum="0.1" Maximum="5" Value="1" AutomationProperties.Name="Gamma"/><TextBlock Text="Alpha"/><Slider AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2" SmallChange="0.05" LargeChange="0.1" x:Name="ImageAlpha" Minimum="0" Maximum="2" Value="1" AutomationProperties.Name="Alpha multiplier"/><Button Content="Apply adjustments" Click="AdjustImage" HorizontalAlignment="Left" Margin="0,9,0,0"/></StackPanel></Expander>
            <Expander Header="Generate" Foreground="#F5F3FA" Margin="0,0,0,14"><StackPanel Margin="0,10,0,0"><TextBlock Text="First color"/><DockPanel><Button DockPanel.Dock="Right" Content="Pick" Click="PickFieldColor" Tag="{Binding ElementName=GenerateFirst}" ToolTip="Choose color and opacity" Margin="8,0,0,0"/><TextBox x:Name="GenerateFirst" Text="#BFA4FCFF" AutomationProperties.Name="First generated color" Margin="0,5,0,9"/></DockPanel><TextBlock Text="Second color"/><DockPanel><Button DockPanel.Dock="Right" Content="Pick" Click="PickFieldColor" Tag="{Binding ElementName=GenerateLast}" ToolTip="Choose color and opacity" Margin="8,0,0,0"/><TextBox x:Name="GenerateLast" Text="#30214000" AutomationProperties.Name="Second generated color" Margin="0,5,0,9"/></DockPanel><ComboBox x:Name="GradientDirection" SelectedIndex="0" AutomationProperties.Name="Gradient direction"><ComboBoxItem Content="Horizontal"/><ComboBoxItem Content="Vertical"/></ComboBox><WrapPanel Margin="0,9,0,9"><Button Content="Fill" Click="FillImage"/><Button Content="Gradient" Click="GradientImage"/></WrapPanel><TextBlock Text="Border thickness"/><TextBox x:Name="ImageBorderWidth" Text="1" AutomationProperties.Name="Generated border thickness" Margin="0,5,0,0"/><Button Content="Add border" Click="BorderImage" HorizontalAlignment="Left" Margin="0,9,0,0"/></StackPanel></Expander>
            <Expander Header="Slice guides" IsExpanded="True" Foreground="#F5F3FA" Margin="0,0,0,14"><StackPanel Margin="0,10,0,0"><UniformGrid Columns="4"><StackPanel><TextBlock Text="Left"/><TextBox x:Name="SliceLeft" Text="0" AutomationProperties.Name="Left fixed border" Margin="0,5,5,0"/></StackPanel><StackPanel><TextBlock Text="Top"/><TextBox x:Name="SliceTop" Text="0" AutomationProperties.Name="Top fixed border" Margin="0,5,5,0"/></StackPanel><StackPanel><TextBlock Text="Right"/><TextBox x:Name="SliceRight" Text="0" AutomationProperties.Name="Right fixed border" Margin="0,5,5,0"/></StackPanel><StackPanel><TextBlock Text="Bottom"/><TextBox x:Name="SliceBottom" Text="0" AutomationProperties.Name="Bottom fixed border" Margin="0,5,0,0"/></StackPanel></UniformGrid>
              <TextBlock Text="Clip X / Y / W / H" Foreground="#ADA9BA" Margin="0,12,0,0"/><UniformGrid Columns="4"><TextBox x:Name="ClipX" Text="0" AutomationProperties.Name="Clip X" Margin="0,5,5,0"/><TextBox x:Name="ClipY" Text="0" AutomationProperties.Name="Clip Y" Margin="0,5,5,0"/><TextBox x:Name="ClipWidth" Text="32" AutomationProperties.Name="Clip width" Margin="0,5,5,0"/><TextBox x:Name="ClipHeight" Text="24" AutomationProperties.Name="Clip height" Margin="0,5,0,0"/></UniformGrid><Button Content="Set guides" Click="SetImageGuides" HorizontalAlignment="Left" Margin="0,9,0,0"/></StackPanel></Expander>
          </StackPanel><TextBlock x:Name="ImageRecipeSummary" Foreground="#ADA9BA" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock x:Name="TextureSource" Foreground="#ADA9BA" TextWrapping="Wrap"/><Button Content="Reset all images" Click="ResetAllImages" IsEnabled="{Binding CanEditDocument}" HorizontalAlignment="Left" Margin="0,16,0,0" ToolTip="Restore all inherited images and remove image recipes. Keeps palette, fonts, licenses and stored history. Undo restores your edits."/></StackPanel></ScrollViewer>
      </Grid></TabItem>
      <TabItem Header="Fonts"><StackPanel Margin="20"><ComboBox x:Name="FontList" Width="350" HorizontalAlignment="Left" AutomationProperties.Name="Native font configuration"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0" IsEnabled="{Binding CanEditDocument}"><Button Content="Use configuration" Click="UseFont"/><Button Content="Embed font" Click="EmbedFont"/><Button Content="Reset font" Click="ResetFont"/></StackPanel><TextBlock x:Name="FontStatus" TextWrapping="Wrap" Margin="0,20,0,0"/></StackPanel></TabItem>
      <TabItem Header="Layout XML"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button Content="Load inherited" DockPanel.Dock="Right" Click="LoadXml"/><ComboBox x:Name="XmlFile" AutomationProperties.Name="Appearance XML file"/></DockPanel><TextBox Grid.Row="1" x:Name="XmlEditor" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Appearance XML"/><Button Grid.Row="2" Content="Validate and set override" Click="SetXml" IsEnabled="{Binding CanEditDocument}" HorizontalAlignment="Left" Margin="0,12,0,0"/></Grid></TabItem>
      <TabItem x:Name="ProjectTab" Header="Project"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20" MaxWidth="800" HorizontalAlignment="Left"><StackPanel IsEnabled="{Binding CanEditDocument}">
        <TextBlock Text="Name"/><TextBox x:Name="ThemeName" TextChanged="MetadataChanged" Margin="0,6,0,16" AutomationProperties.Name="Theme name" MinWidth="600"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Author"/><TextBox x:Name="ThemeAuthor" TextChanged="MetadataChanged" Margin="0,6,14,16" AutomationProperties.Name="Theme author"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Version"/><TextBox x:Name="PackageVersion" TextChanged="MetadataChanged" Margin="0,6,0,16" AutomationProperties.Name="Theme version"/></StackPanel></Grid>
        <TextBlock Text="Description"/><TextBox x:Name="ThemeDescription" TextChanged="MetadataChanged" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" Margin="0,6,0,16" AutomationProperties.Name="Theme description"/>
      </StackPanel><TextBlock x:Name="ProjectSummary" Foreground="#ADA9BA" TextWrapping="Wrap"/><TextBox x:Name="RawProject" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="360" Margin="0,16,0,0" Visibility="Collapsed" AutomationProperties.Name="Read-only project source"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <DockPanel Grid.Row="4" Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Close preview" Click="ClosePreview"/><Button Content="Preview in viewer" Click="Preview" Background="#68468A" IsEnabled="{Binding CanEditDocument}" Margin="0"/></StackPanel><TextBlock x:Name="StatusText" Text="Choose a base folder, then create or open a project." Foreground="#ADA9BA" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/></DockPanel>
  </Grid>
</Window>
