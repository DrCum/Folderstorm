<Window x:Class="Folderstorm.Theme.Editor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Folderstorm theme lab" Width="1180" Height="820" MinWidth="900" MinHeight="650" Background="#121018" Foreground="#EDE7F6" Closing="OnClosing">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="Theme lab" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="ProjectLabel" Text="Classic AnsaStorm" Foreground="#B8A8CA" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="New / open" Click="OpenProject"/><Button Content="Save" Click="SaveProject"/><Button Content="Undo" Click="Undo"/><Button Content="Redo" Click="Redo"/><Button Content="Export" Click="Export"/></StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
      <TextBox x:Name="BasePath" AutomationProperties.Name="Base viewer or repository folder" ToolTip="Folder containing the matching viewer's skins and fonts, or its source checkout"/>
      <ComboBox x:Name="BaseScheme" Grid.Column="1" Margin="10,0,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Base scheme"/>
    </Grid>
    <TabControl Grid.Row="2" x:Name="Workspace">
      <TabItem Header="Palette"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Edit a role or an individual color. Linked aliases follow the role." Foreground="#B8A8CA" Margin="0,0,0,14"/>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
          <DockPanel Margin="0,0,18,0"><TextBox x:Name="ColorSearch" DockPanel.Dock="Top" TextChanged="SearchColors" AutomationProperties.Name="Search colors" Margin="0,0,0,10"/><ListBox x:Name="ColorList" SelectionChanged="SelectColor" DisplayMemberPath="Name" AutomationProperties.Name="Color catalog"/></DockPanel>
          <StackPanel Grid.Column="1"><TextBlock x:Name="ColorName" Text="Choose a color" FontSize="20" TextWrapping="Wrap"/><Border x:Name="ColorSwatch" Height="90" Background="#C6ADFF" CornerRadius="6" Margin="0,18,0,16"/><TextBox x:Name="ColorValue" Text="1 1 1 1" AutomationProperties.Name="RGBA value" ToolTip="Four values from 0 to 1: red green blue alpha"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Set color" Click="SetColor"/><Button Content="Reset" Click="ResetColor"/></StackPanel><TextBlock x:Name="ColorSource" Foreground="#B8A8CA" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel>
        </Grid></Grid></TabItem>
      <TabItem Header="Images"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
        <ListBox x:Name="TextureList" DisplayMemberPath="Name" SelectionChanged="SelectTexture" AutomationProperties.Name="Image catalog" Margin="0,0,18,0"/>
        <StackPanel Grid.Column="1"><TextBlock x:Name="TextureName" Text="Choose an image" FontSize="20" TextWrapping="Wrap"/><Border Background="#302A3A" Height="220" Margin="0,16"><Image x:Name="AssetImage" Stretch="Uniform" Margin="12"/></Border><TextBlock x:Name="TextureSource" Foreground="#B8A8CA" TextWrapping="Wrap"/><Button Content="Replace image" Click="ReplaceImage" Margin="0,18,0,0" ToolTip="Original imported bytes are preserved in the project"/></StackPanel>
      </Grid></TabItem>
      <TabItem Header="Fonts"><StackPanel Margin="20"><TextBlock Text="Choose a native font configuration. The exact preview restarts to load it." Foreground="#B8A8CA" Margin="0,0,0,18"/><ComboBox x:Name="FontList" Width="350" HorizontalAlignment="Left" AutomationProperties.Name="Native font configuration"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="Use configuration" Click="UseFont"/><Button Content="Embed font" Click="EmbedFont"/><Button Content="Reset font" Click="ResetFont"/></StackPanel><TextBlock x:Name="FontStatus" TextWrapping="Wrap" Margin="0,20,0,0"/></StackPanel></TabItem>
      <TabItem Header="Layout XML"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button Content="Load inherited" DockPanel.Dock="Right" Click="LoadXml"/><ComboBox x:Name="XmlFile" AutomationProperties.Name="Appearance XML file"/></DockPanel><TextBox Grid.Row="1" x:Name="XmlEditor" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Appearance XML"/><Button Grid.Row="2" Content="Validate and set override" Click="SetXml" HorizontalAlignment="Left" Margin="0,12,0,0"/></Grid></TabItem>
      <TabItem Header="Project"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Name"/><TextBox x:Name="ThemeName" Grid.Row="1" Margin="0,8,0,18" AutomationProperties.Name="Theme name"/><TextBlock Grid.Row="2" Text="Runtime packages contain compiled overrides. Save the project to retain recipes and undo history." Foreground="#B8A8CA" TextWrapping="Wrap"/></Grid></TabItem>
    </TabControl>
    <StackPanel Grid.Row="3" Margin="0,16,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Close preview" Click="ClosePreview"/><Button DockPanel.Dock="Right" Content="Preview in viewer" Click="Preview" Background="#68468A"/><TextBox x:Name="ViewerPath" AutomationProperties.Name="Matching viewer executable" ToolTip="The matching viewer executable with offline preview capability" Margin="0,0,14,0"/></DockPanel><TextBlock x:Name="StatusText" Text="Choose a base folder, then create or open a project." Foreground="#B8A8CA" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel>
  </Grid>
</Window>
