<Window x:Class="Folderstorm.Theme.Editor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Folderstorm.Theme.Editor" Title="Folderstorm theme lab · Authoring" Width="1360" Height="900" MinWidth="1080" MinHeight="700" Background="#111016" Foreground="#F5F3FA" Closing="OnClosing">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="Theme lab" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="ProjectLabel" Text="Classic AnsaStorm" Foreground="#ADA9BA" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="420"/></StackPanel>
      <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="New / open" Click="OpenProject"/><Button Content="Save" Click="SaveProject" IsEnabled="{Binding CanEditDocument}"/><Button Content="Undo" Click="Undo" IsEnabled="{Binding CanUndo}"/><Button Content="Redo" Click="Redo" IsEnabled="{Binding CanRedo}"/><Button Content="Export" Click="Export" IsEnabled="{Binding CanEditDocument}"/></WrapPanel>
    </DockPanel>
    <Expander x:Name="SetupExpander" Grid.Row="1" Header="Setup" Margin="0,0,0,12" Foreground="#ADA9BA" IsExpanded="True">
      <Grid Margin="0,10,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Base viewer folder" Margin="0,0,0,5"/><TextBox x:Name="BasePath" AutomationProperties.Name="Base viewer or repository folder" ToolTip="Matching viewer's skins and fonts, or source checkout"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="New project scheme" Margin="0,0,0,5"/><ComboBox x:Name="BaseScheme" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Base scheme"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Preview viewer" Margin="0,0,0,5"/><TextBox x:Name="ViewerPath" AutomationProperties.Name="Matching viewer executable" ToolTip="Viewer executable with offline theme preview support"/></StackPanel>
      </Grid>
    </Expander>
    <Border x:Name="ReadOnlyBanner" Grid.Row="2" Background="#3A2D20" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock x:Name="ReadOnlyMessage" Foreground="#F2CD94" TextWrapping="Wrap"/></Border>
    <TabControl Grid.Row="3" x:Name="Workspace">
      <TabItem Header="Palette"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="255" MinWidth="190"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="300" MinWidth="270"/></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,6,0">
          <StackPanel DockPanel.Dock="Top"><ComboBox x:Name="ColorScope" SelectedIndex="0" SelectionChanged="FilterColors" AutomationProperties.Name="Color scope"><ComboBoxItem Content="Roles"/><ComboBoxItem Content="All colors"/><ComboBoxItem Content="Overrides"/><ComboBoxItem Content="Affected colors"/></ComboBox><TextBox x:Name="ColorSearch" TextChanged="SearchColors" AutomationProperties.Name="Search colors" ToolTip="Search color IDs" Margin="0,9,0,10"/></StackPanel>
          <Button DockPanel.Dock="Bottom" Content="Reset palette" Click="ResetPalette" IsEnabled="{Binding CanEditDocument}" Margin="0,10,0,0"/>
          <ListBox x:Name="ColorList" SelectionChanged="SelectColor" AutomationProperties.Name="Color catalog"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Rectangle Width="15" Height="15" Fill="{Binding Swatch}" Stroke="#766B89" VerticalAlignment="Top" Margin="0,2,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding State}" Foreground="#ADA9BA" FontSize="11" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
        </DockPanel>
        <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Center" Background="#302D3B"/>
        <Grid Grid.Column="2" Margin="8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <DockPanel Margin="8,2,8,14"><TextBlock Text="Quick preview" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="WPF approximation" Foreground="#ADA9BA" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
          <TextBlock Grid.Row="1" Text="Before" Foreground="#ADA9BA" Margin="8,0,0,3"/>
          <local:PaletteSample Grid.Row="2" x:Name="BeforeSample" MinHeight="165"/>
          <TextBlock Grid.Row="3" Text="After" Foreground="#BFA4FC" Margin="8,12,0,3"/>
          <local:PaletteSample Grid.Row="4" x:Name="AfterSample" MinHeight="165"/>
        </Grid>
        <GridSplitter Grid.Column="3" Width="2" HorizontalAlignment="Center" Background="#302D3B"/>
        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="10,0,0,0">
          <TextBlock x:Name="ColorName" Text="Choose a color" FontSize="20" TextWrapping="Wrap"/><TextBlock x:Name="ColorState" Foreground="#BFA4FC" Margin="0,5,0,0"/>
          <Border Height="70" Margin="0,16,0,14" Background="{StaticResource Checkerboard}"><Border x:Name="ColorSwatch"/></Border>
          <StackPanel IsEnabled="{Binding CanEditDocument}"><TextBlock Text="Hex / RGBA" Foreground="#ADA9BA" Margin="0,0,0,5"/><TextBox x:Name="ColorValue" Text="#FFFFFFFF" FontFamily="Consolas" AutomationProperties.Name="Hex or RGBA value"/><TextBlock x:Name="ColorFormats" Foreground="#ADA9BA" FontFamily="Consolas" FontSize="11" Margin="0,6,0,8" TextWrapping="Wrap"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="R"/><Slider Grid.Column="1" x:Name="RedChannel" Minimum="0" Maximum="255" TickFrequency="1" ValueChanged="ChannelChanged" AutomationProperties.Name="Red channel"/><TextBlock Grid.Column="2" Text="{Binding ElementName=RedChannel,Path=Value,StringFormat={}{0:F0}}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="1" Text="G"/><Slider Grid.Row="1" Grid.Column="1" x:Name="GreenChannel" Minimum="0" Maximum="255" ValueChanged="ChannelChanged" AutomationProperties.Name="Green channel"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=GreenChannel,Path=Value,StringFormat={}{0:F0}}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="2" Text="B"/><Slider Grid.Row="2" Grid.Column="1" x:Name="BlueChannel" Minimum="0" Maximum="255" ValueChanged="ChannelChanged" AutomationProperties.Name="Blue channel"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ElementName=BlueChannel,Path=Value,StringFormat={}{0:F0}}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="3" Text="A"/><Slider Grid.Row="3" Grid.Column="1" x:Name="AlphaChannel" Minimum="0" Maximum="255" ValueChanged="ChannelChanged" AutomationProperties.Name="Alpha channel"/><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ElementName=AlphaChannel,Path=Value,StringFormat={}{0:F0}}" HorizontalAlignment="Right"/>
            </Grid>
            <WrapPanel Margin="0,14,0,16"><Button Content="Set color" Click="SetColor"/><Button Content="Reset" Click="ResetColor"/></WrapPanel>
            <TextBlock Text="Link to color" Foreground="#ADA9BA" Margin="0,0,0,5"/><ComboBox x:Name="ColorLinkTarget" IsEditable="True" IsTextSearchEnabled="True" AutomationProperties.Name="Linked color ID"/><Button Content="Set link" Click="SetColorLink" HorizontalAlignment="Left" Margin="0,9,0,0"/>
          </StackPanel>
          <TextBlock x:Name="ColorContrast" Margin="0,18,0,0" Foreground="#64D8B2"/><TextBlock x:Name="ColorSource" Foreground="#ADA9BA" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock x:Name="ColorAffected" Foreground="#ADA9BA" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel></ScrollViewer>
      </Grid></TabItem>
      <TabItem Header="Images"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
        <ListBox x:Name="TextureList" DisplayMemberPath="Name" SelectionChanged="SelectTexture" AutomationProperties.Name="Image catalog" Margin="0,0,18,0"/>
        <StackPanel Grid.Column="1"><TextBlock x:Name="TextureName" Text="Choose an image" FontSize="20" TextWrapping="Wrap"/><Border Background="{StaticResource Checkerboard}" Height="220" Margin="0,16"><Image x:Name="AssetImage" Stretch="Uniform" Margin="12"/></Border><TextBlock x:Name="TextureSource" Foreground="#ADA9BA" TextWrapping="Wrap"/><Button Content="Replace image" Click="ReplaceImage" IsEnabled="{Binding CanEditDocument}" Margin="0,18,0,0" ToolTip="Original imported bytes are preserved in the project"/></StackPanel>
      </Grid></TabItem>
      <TabItem Header="Fonts"><StackPanel Margin="20"><ComboBox x:Name="FontList" Width="350" HorizontalAlignment="Left" AutomationProperties.Name="Native font configuration"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0" IsEnabled="{Binding CanEditDocument}"><Button Content="Use configuration" Click="UseFont"/><Button Content="Embed font" Click="EmbedFont"/><Button Content="Reset font" Click="ResetFont"/></StackPanel><TextBlock x:Name="FontStatus" TextWrapping="Wrap" Margin="0,20,0,0"/></StackPanel></TabItem>
      <TabItem Header="Layout XML"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button Content="Load inherited" DockPanel.Dock="Right" Click="LoadXml"/><ComboBox x:Name="XmlFile" AutomationProperties.Name="Appearance XML file"/></DockPanel><TextBox Grid.Row="1" x:Name="XmlEditor" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Appearance XML"/><Button Grid.Row="2" Content="Validate and set override" Click="SetXml" IsEnabled="{Binding CanEditDocument}" HorizontalAlignment="Left" Margin="0,12,0,0"/></Grid></TabItem>
      <TabItem x:Name="ProjectTab" Header="Project"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20" MaxWidth="800" HorizontalAlignment="Left"><StackPanel IsEnabled="{Binding CanEditDocument}">
        <TextBlock Text="Name"/><TextBox x:Name="ThemeName" TextChanged="MetadataChanged" Margin="0,6,0,16" AutomationProperties.Name="Theme name" MinWidth="600"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Author"/><TextBox x:Name="ThemeAuthor" TextChanged="MetadataChanged" Margin="0,6,14,16" AutomationProperties.Name="Theme author"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Version"/><TextBox x:Name="PackageVersion" TextChanged="MetadataChanged" Margin="0,6,0,16" AutomationProperties.Name="Theme version"/></StackPanel></Grid>
        <TextBlock Text="Description"/><TextBox x:Name="ThemeDescription" TextChanged="MetadataChanged" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" Margin="0,6,0,16" AutomationProperties.Name="Theme description"/>
      </StackPanel><TextBlock x:Name="ProjectSummary" Foreground="#ADA9BA" TextWrapping="Wrap"/><TextBox x:Name="RawProject" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="360" Margin="0,16,0,0" Visibility="Collapsed" AutomationProperties.Name="Read-only project source"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <DockPanel Grid.Row="4" Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Close preview" Click="ClosePreview"/><Button Content="Preview in viewer" Click="Preview" Background="#68468A" IsEnabled="{Binding CanEditDocument}" Margin="0"/></StackPanel><TextBlock x:Name="StatusText" Text="Choose a base folder, then create or open a project." Foreground="#ADA9BA" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/></DockPanel>
  </Grid>
</Window>
