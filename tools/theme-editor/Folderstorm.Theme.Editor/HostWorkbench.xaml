<UserControl x:Class="Folderstorm.Theme.Editor.HostWorkbench" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#F5F3FA">
  <Grid Margin="14" TextElement.Foreground="#F5F3FA">
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Session host" FontSize="20" Margin="0,0,0,12"/><TextBlock Grid.Row="1" x:Name="PaletteState" Foreground="#ADA9BA" TextWrapping="Wrap" Margin="0,0,0,14"/>
      <ListBox Grid.Row="2" x:Name="Roles" SelectionChanged="SelectRole" AutomationProperties.Name="Host color roles" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="6,8"><Border Width="20" Height="20" Background="{Binding Swatch}" BorderBrush="#736787" BorderThickness="1" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Button Grid.Row="3" x:Name="ResetHost" Content="Reset host palette" Click="ResetPalette" IsEnabled="{Binding CanEditDocument}" Margin="0,14,0,0" ToolTip="Remove the host override. The host uses its own built-in theme again. Undo restores the palette."/>
    </Grid>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">
      <TextBlock Text="Palette sample" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <Border x:Name="SampleFrame" BorderThickness="1" Padding="16"><StackPanel>
        <TextBlock x:Name="SampleTitle" Text="Folderstorm" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock x:Name="SampleMuted" Text="Your sessions" Margin="0,0,0,18"/>
        <Border x:Name="SamplePanel" BorderThickness="1" Padding="16" Margin="0,0,0,14"><StackPanel><TextBlock x:Name="SampleText" Text="Welcome back" FontSize="16" Margin="0,0,0,12"/><Border x:Name="SampleInput" BorderThickness="1" Padding="10"><TextBlock x:Name="SamplePlaceholder" Text="Search sessions"/></Border></StackPanel></Border>
        <Border x:Name="SampleButton" BorderThickness="1" Padding="12,8" HorizontalAlignment="Left"><TextBlock x:Name="SampleButtonText" Text="Open session"/></Border>
      </StackPanel></Border>
      <TextBlock Text="Approximate colors. Windows high contrast takes precedence in the host." Foreground="#ADA9BA" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,0">
      <TextBlock x:Name="RoleName" FontSize="20" Margin="0,0,0,12"/><Border x:Name="ChosenColor" Height="76" Margin="0,0,0,14"/>
      <TextBlock Text="Hex / RGB"/><TextBox x:Name="ColorValue" AutomationProperties.Name="Host color value" FontFamily="Consolas" Margin="0,6,0,10" ToolTip="Opaque #RRGGBB. Host controls do not use transparency."/>
      <WrapPanel IsEnabled="{Binding CanEditDocument}"><Button Content="Pick…" Click="PickColor" Margin="0,0,8,8"/><Button Content="Set color" Click="SetColor" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock Text="Start from" Margin="0,20,0,6"/><ComboBox x:Name="Preset" SelectionChanged="SelectPreset" AutomationProperties.Name="Host palette preset"><ComboBoxItem Content="Midnight"/><ComboBoxItem Content="Daylight"/></ComboBox>
      <WrapPanel IsEnabled="{Binding CanEditDocument}" Margin="0,10,0,0"><Button Content="Use preset" Click="UsePreset" Margin="0,0,8,8"/><Button Content="From viewer colors" Click="FromViewer" Margin="0,0,0,8" ToolTip="Copy a snapshot of viewer palette roles. Transparent colors are composited over the background, which is composited over Midnight. Later viewer edits do not change this host palette."/></WrapPanel>
      <TextBlock x:Name="Status" Foreground="#F2CD94" TextWrapping="Wrap" Margin="0,14,0,0"/>
    </StackPanel></ScrollViewer>
  </Grid>
</UserControl>
