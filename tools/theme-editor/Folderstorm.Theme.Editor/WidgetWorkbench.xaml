<UserControl x:Class="Folderstorm.Theme.Editor.WidgetWorkbench" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Folderstorm.Theme.Editor" Foreground="#F5F3FA">
  <Grid Margin="14" TextElement.Foreground="#F5F3FA">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Reset file" Click="ResetFile" IsEnabled="{Binding CanEditDocument}" Margin="12,0,0,0"/><ComboBox x:Name="FileChoice" SelectionChanged="SelectFile" AutomationProperties.Name="Widget XML file"/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
      <DockPanel><TextBox DockPanel.Dock="Top" x:Name="ControlSearch" TextChanged="SearchControls" AutomationProperties.Name="Search widget controls" ToolTip="Search control type or name" Margin="0,0,0,10"/><ListBox x:Name="Controls" DisplayMemberPath="Label" SelectionChanged="SelectControl" AutomationProperties.Name="Widget controls" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></DockPanel>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><TextBlock x:Name="ControlTitle" Text="Choose a control" FontSize="21" TextTrimming="CharacterEllipsis"/><TextBlock DockPanel.Dock="Right" Text="WPF approximation" Foreground="#ADA9BA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/></DockPanel>
        <DockPanel Grid.Row="1" Margin="0,12,0,7"><TextBlock Text="Before" VerticalAlignment="Center"/><ComboBox DockPanel.Dock="Right" x:Name="PreviewState" SelectionChanged="StateChanged" AutomationProperties.Name="Widget preview state" Width="172" HorizontalAlignment="Right"/></DockPanel>
        <Border Grid.Row="2" Background="{StaticResource Checkerboard}" BorderBrush="#51445F" BorderThickness="1" ClipToBounds="True"><local:WidgetSample x:Name="BeforeSample"/></Border>
        <TextBlock Grid.Row="3" Text="After" Margin="0,12,0,7"/>
        <Border Grid.Row="4" Background="{StaticResource Checkerboard}" BorderBrush="#51445F" BorderThickness="1" ClipToBounds="True"><local:WidgetSample x:Name="AfterSample"/></Border>
        <TextBlock Grid.Row="5" x:Name="SampleDetail" Foreground="#ADA9BA" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </Grid>
      <ScrollViewer Grid.Column="4" x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0"><StackPanel>
        <ComboBox x:Name="PropertyFilter" SelectedIndex="0" SelectionChanged="FilterProperties" AutomationProperties.Name="Widget property filter"><ComboBoxItem Content="Editable properties"/><ComboBoxItem Content="Changed properties"/><ComboBoxItem Content="All properties"/></ComboBox>
        <ListBox x:Name="Properties" DisplayMemberPath="Label" Height="166" SelectionChanged="SelectProperty" AutomationProperties.Name="Widget properties" Margin="0,9,0,12" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        <TextBlock Text="Other supported property" Foreground="#ADA9BA"/><ComboBox x:Name="ExtraProperty" SelectionChanged="SelectExtraProperty" AutomationProperties.Name="Additional widget property" Margin="0,5,0,14"/>
        <TextBlock x:Name="PropertyName" FontSize="19" TextWrapping="Wrap"/><TextBlock x:Name="PropertyState" Foreground="#ADA9BA" TextWrapping="Wrap" Margin="0,5,0,8"/>
        <StackPanel IsEnabled="{Binding CanEditDocument}">
          <TextBox x:Name="PropertyValue" AcceptsReturn="True" TextWrapping="Wrap" Height="70" MaxLength="4096" VerticalScrollBarVisibility="Auto" TextChanged="DraftChanged" AutomationProperties.Name="Widget property value"/>
          <WrapPanel x:Name="PickRow" Margin="0,8,0,0"><Button x:Name="PickColorButton" Content="Pick color" Click="PickColor"/></WrapPanel>
          <TextBlock x:Name="ValueChoiceLabel" Foreground="#ADA9BA" Margin="0,10,0,4" Visibility="Collapsed"/><ComboBox x:Name="ValueChoice" SelectionChanged="ChooseValue" AutomationProperties.Name="Known widget reference" Visibility="Collapsed"/>
          <WrapPanel Margin="0,12,0,0"><Button x:Name="ApplyPropertyButton" Content="Set property" Click="ApplyProperty"/><Button x:Name="ResetPropertyButton" Content="Reset property" Click="ResetProperty"/></WrapPanel>
        </StackPanel>
        <TextBlock x:Name="InheritedValue" Foreground="#ADA9BA" TextWrapping="Wrap" Margin="0,14,0,0"/>
        <TextBlock x:Name="Status" Foreground="#64D8B2" TextWrapping="Wrap" Margin="0,14,0,0"/>
      </StackPanel></ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="Provenance" Foreground="#ADA9BA" TextWrapping="Wrap" MaxHeight="58" Margin="0,12,0,0"/>
  </Grid>
</UserControl>
