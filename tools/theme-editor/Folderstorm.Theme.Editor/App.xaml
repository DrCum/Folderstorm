<Application x:Class="Folderstorm.Theme.Editor.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Surface" Color="#201D2A"/>
    <SolidColorBrush x:Key="Accent" Color="#C6ADFF"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDE7F6"/></Style>
    <Style TargetType="Control"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#EDE7F6"/></Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type Control}}"><Setter Property="Background" Value="#17141F"/><Setter Property="BorderBrush" Value="#51445F"/><Setter Property="Padding" Value="9,6"/><Setter Property="CaretBrush" Value="White"/><Setter Property="SelectionBrush" Value="#705294"/></Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Control}}">
      <Setter Property="Background" Value="#3E3155"/><Setter Property="BorderBrush" Value="#665078"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#58416F"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#735392"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type Control}}"><Setter Property="Background" Value="#17141F"/><Setter Property="BorderBrush" Value="#51445F"/><Setter Property="Padding" Value="6"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#EDE7F6"/><Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type Control}}"><Setter Property="Background" Value="#201D2A"/><Setter Property="BorderBrush" Value="#51445F"/></Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type Control}}"><Setter Property="Foreground" Value="#201629"/><Setter Property="Padding" Value="18,9"/></Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type Control}}"><Setter Property="Foreground" Value="#201629"/><Setter Property="Padding" Value="7"/></Style>
  </Application.Resources>
</Application>
